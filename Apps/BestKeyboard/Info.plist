<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WhatsApp "Sohbeti Dışa Aktar" paylaşım menüsünde görünmek için:
	     sohbet dosyası (zip/txt) ve Telegram result.json açılabiliyor. -->
