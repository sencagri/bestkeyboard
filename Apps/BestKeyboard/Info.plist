	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sencagri.bestkeyboard</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bestkeyboard</string>
			</array>
		</dict>
	</array>
